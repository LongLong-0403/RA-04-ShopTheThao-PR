DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=app_db

APP_NAME=Shop Thể Thao API
# Danh sách origin cách nhau dấu phẩy, vd: http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=*

# Khoá ký JWT: đặt chuỗi ngẫu nhiên dài, tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Để trống -> mỗi lần khởi động sinh khoá mới, token cũ mất hiệu lực.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
